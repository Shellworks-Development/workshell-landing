  "narrative": {
    "northStar": "One session, one spine",
    "overview": "The page is a single real player session told top to bottom along a timestamped rail, in the Workshell dashboard's own light and dark themes. Every capability appears as the moment it happened, proven by real values from the recorded session.",
    "keyCharacteristics": [
      "One spine, strictly forward in time",
      "Times in the gutter beside their dot",
